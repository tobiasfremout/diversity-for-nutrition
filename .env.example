# Copia este archivo como .env y ajusta los valores
# El ACCOUNT se obtiene automaticamente de las credenciales AWS configuradas

# Region de AWS donde estan los repositorios ECR
AWS_REGION=us-east-1

# Nombre del repositorio ECR de la imagen base (R + GDAL + paquetes)
BASE_REPO=r-lambda-d4n-base

# Nombre del repositorio ECR de la funcion Lambda
FUNCTION_REPO=r-lambda-d4n

# Nombre de la funcion Lambda a actualizar con ./build.sh deploy
LAMBDA_FUNCTION=d4n
